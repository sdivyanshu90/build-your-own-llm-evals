{
  "annotations": {"list": []},
  "editable": false,
  "panels": [
    {
      "title": "API request rate",
      "type": "timeseries",
      "targets": [
        {"expr": "sum by (status) (rate(eval_http_requests_total[5m]))", "legendFormat": "{{status}}"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "title": "API p95 latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(eval_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "title": "Queue depth",
      "type": "timeseries",
      "targets": [{"expr": "eval_queue_depth", "legendFormat": "{{queue}}"}],
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8}
    },
    {
      "title": "Provider p95 latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, provider_type, operation) (rate(eval_provider_duration_seconds_bucket[5m])))",
          "legendFormat": "{{provider_type}} / {{operation}}"
        }
      ],
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8}
    },
    {
      "title": "Tokens and cost",
      "type": "timeseries",
      "targets": [
        {"expr": "sum by (kind) (rate(eval_tokens_total[5m]))", "legendFormat": "tokens {{kind}}"},
        {"expr": "sum(rate(eval_cost_usd_total[5m]))", "legendFormat": "USD/s"}
      ],
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8}
    },
    {
      "title": "Judge disagreement",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(eval_judge_disagreement_ratio_bucket[15m])))",
          "legendFormat": "p95 disagreement"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
    },
    {
      "title": "Task failures",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (category, retryable) (rate(eval_task_failures_total[5m]))",
          "legendFormat": "{{category}} retryable={{retryable}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
    }
  ],
  "schemaVersion": 41,
  "tags": ["llm-evaluation"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "title": "LLM Evaluation Platform",
  "uid": "llm-eval-platform",
  "version": 1
}
