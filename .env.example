# Runtime mode: development enables header-based local identity and must never be
# used on an Internet-facing deployment.
EVAL_ENVIRONMENT=development
EVAL_AUTH_MODE=development
EVAL_LOG_LEVEL=INFO
EVAL_CORS_ORIGINS=http://localhost:5173
EVAL_API_BASE_URL=http://localhost:8000
# Compose image names may be redirected to an internal registry.
EVAL_BACKEND_IMAGE=llm-eval-backend:local
EVAL_WEB_IMAGE=llm-eval-web:local

# PostgreSQL is the durable source of truth.
EVAL_DATABASE_URL=postgresql+asyncpg://eval:eval-local-only@postgres:5432/eval
POSTGRES_DB=eval
POSTGRES_USER=eval
POSTGRES_PASSWORD=eval-local-only
# Host-only diagnostic ports; containers continue to use 5432/6379/9000/9001.
EVAL_POSTGRES_HOST_PORT=55432
EVAL_REDIS_HOST_PORT=56379
EVAL_MINIO_HOST_PORT=59000
EVAL_MINIO_CONSOLE_HOST_PORT=59001

# Redis contains disposable queue and coordination state.
EVAL_REDIS_URL=redis://redis:6379/0
EVAL_CELERY_BROKER_URL=redis://redis:6379/1

# MinIO is the local S3-compatible object store.
EVAL_S3_ENDPOINT_URL=http://minio:9000
EVAL_S3_REGION=us-east-1
EVAL_S3_BUCKET=llm-eval-artifacts
EVAL_S3_ACCESS_KEY_ID=eval-local-access
EVAL_S3_SECRET_ACCESS_KEY=eval-local-secret-change-me
MINIO_ROOT_USER=eval-local-access
MINIO_ROOT_PASSWORD=eval-local-secret-change-me

# API keys are hashed with this independent server-side pepper. Generate at
# least 32 random bytes for every non-development environment.
EVAL_API_KEY_PEPPER=development-pepper-change-before-production

# Resource and cost controls.
EVAL_MAX_UPLOAD_BYTES=104857600
EVAL_MAX_IMPORT_RECORDS=1000000
EVAL_MAX_RESPONSE_BYTES=10485760
EVAL_RATE_LIMIT_ENABLED=true
EVAL_RATE_LIMIT_REQUESTS_PER_MINUTE=600
EVAL_DISPATCH_WINDOW=500
EVAL_OUTBOX_RELAY_INTERVAL_SECONDS=5
EVAL_WORKER_CONCURRENCY=4
EVAL_PROVIDER_TIMEOUT_SECONDS=60
EVAL_PROVIDER_MAX_ATTEMPTS=4
EVAL_DEFAULT_PROJECT_CONCURRENCY=8
EVAL_DEFAULT_BUDGET_USD=100.000000000000

# OpenTelemetry export is disabled when this is empty.
EVAL_OTLP_ENDPOINT=
EVAL_SERVICE_VERSION=0.1.0

# External provider keys are supplied to worker processes by the deployment
# secret manager. They are examples only and must remain empty in committed files.
GEMINI_API_KEY=
GENERIC_PROVIDER_API_KEY=
